# Persistent production database. Use PostgreSQL for the shared team app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google Places + Routes. Keep the real key out of GitHub.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Gemini AI for Ask + voice/text extraction.
GEMINI_API_KEY=your_gemini_api_key

# Optional local SQLite path when DATABASE_URL is not set.
# FIELD_DB=field_intel.db

# Optional seed filename inside data/
SEED_CSV=synthetic_field_visits_110_records.csv
